local STRATAGEMS = {
    {id="fire",   name="火计",   desc="烧毁敌城粮仓 驻军-20",    cost=120, icon="🔥", successRate=0.5},
    {id="spy",    name="离间",   desc="降低敌城士气-25",          cost=150, icon="📜", successRate=0.6},
    {id="defect", name="招降",   desc="尝试策反敌将归我",         cost=300, icon="🏳", successRate=0.2},
